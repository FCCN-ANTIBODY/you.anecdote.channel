#!/bin/zsh
# deploy — upload this repository to its Cloudflare Pages project, from here.
#
#     bin/deploy            deploy HEAD's working tree. Refuses a dirty tree.
#     bin/deploy --dirty    deploy anyway, and say so in the deployment message.
#
# REFUSES A FAT MOUNT. mounts.txt says which directories of each submodule are
# the site; if the checkout is wider than that, this stops before uploading.
#
# NO BUILD. The repository is the site (wrangler.jsonc: pages_build_output_dir "."),
# so what is uploaded is what is committed, and the deployment message is the
# commit it came from.
#
# DIES LOUDLY, ON PURPOSE. discoverywritten.com's deploy.yml records why: a laptop
# OAuth token expired silently on 2026-08-27 and two days of merges built nothing.
# So this asks `wrangler whoami` FIRST and stops if the login is gone, and after
# the upload it fetches you.yml back from the instance's own name and compares it
# byte-for-byte to the file here. A deploy that reports success and serves the old
# bytes -- wrong project, name not attached, edge cache -- fails right here rather
# than at the first enrollment.
emulate -L zsh
set -euo pipefail
cd "${0:A:h:h}"

W=(npx -y wrangler@4)

if [[ -n "$(git status --porcelain)" && "${1:-}" != "--dirty" ]]; then
  print -u2 "deploy: working tree is dirty. Commit, or --dirty to say so in the deployment."
  git status --short >&2
  exit 1
fi

print "mounts:"
bin/mount check || { print -u2 "deploy: a mount is not sparse. \`bin/mount\`, then try again. Nothing uploaded."; exit 1; }

$W whoami >/dev/null 2>&1 || { print -u2 "deploy: not logged in to Cloudflare (npx wrangler login). Nothing uploaded."; exit 78; }

sha=$(git rev-parse --short HEAD)
msg="$sha"
[[ "${1:-}" == "--dirty" ]] && msg="$sha (dirty tree)"
url=$(sed -nE 's/^url:[[:space:]]*"?([^"]+)"?/\1/p' you.yml | head -1)

$W pages deploy . --commit-dirty=true --commit-message "$msg"

# VERIFY THE WAY A BROWSER LOADS IT. A module import is a CORS request carrying an Origin header,
# and Cloudflare caches that variant separately from the one curl gets; measured 2026-09-21, a
# changed module stayed stale at the edge for browsers only, after a deploy that reported success
# and after a plain fetch agreed with the tree. So every file is fetched with the Origin header set,
# and compared byte-for-byte with what is here. Any difference means the deploy is not done, and the
# way out is either time or a purge in the dashboard -- the token here cannot purge.
print "\nverifying every file at $url as a browser would fetch it…"
stale=(); n=0
for f in $(git ls-files --recurse-submodules | grep -v -E '^(\.gitmodules|\.gitignore|\.pr|mounts\.txt|_headers|_redirects|wrangler\.jsonc)$'); do
  [[ -f "$f" ]] || continue
  n=$((n+1))
  # Pages serves x.html at x (308 from x.html); ask for the served name.
  case "$f" in
    index.html)      u="$url/";;
    */index.html)    u="$url/${f%index.html}";;
    *.html)          u="$url/${f%.html}";;
    *)               u="$url/$f";;
  esac
  if ! curl -fsS -H "Origin: $url" "$u" 2>/dev/null | cmp -s - "$f"; then stale+=("$f"); fi
done
if (( ${#stale} == 0 )); then
  print "  all $n files agree. $url is serving $sha."
  exit 0
fi
print -u2 "  ${#stale} of $n file(s) differ from the tree when fetched with an Origin header:"
for f in $stale; do print -u2 "    $f"; done
print -u2 "  The edge is holding an old copy for browsers. Not done: wait it out, or purge the zone's"
print -u2 "  cache in the dashboard (Caching → Configuration → Purge Everything), then run this again."
exit 1
