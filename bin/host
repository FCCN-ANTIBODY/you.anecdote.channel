#!/usr/bin/python3
"""host — the node that mounts this engine, and the instance it holds for it.

    bin/host              which node is hosting these bytes, and what it answers
    bin/host path <label> where the host keeps one wanted label; prints nothing if unbound
    bin/host instance     the instance values, as `key=value` lines

AN ENGINE HOLDS NO INSTANCE. That is the rule every other engine on a station already keeps:
`.stagecraft-engine`, `.proofing-engine` and `.estray-engine` carry no `NAME` and no instance file
at all, and `.library-engine`'s `NAME` is its own canonical address rather than a deployment. This
engine broke it -- it carried `you.discoverywritten.com` as its NAME, plus an arrangement, a channel
index and published artifacts -- which conflated the code with one operator's website.

SO THE CONTEXT COMES FROM THE REPOSITORY THAT SUBMODULED US. A checkout at `<node>/.you-engine` is
being wielded by that node, and the node is what knows which site this is, who may open a sealed
bottle, and where the artifacts live. `residency.yml` declares those as `wants:` LABELS, never paths
-- the same discipline `.ablative-engine/residency.yml` states in its own words: *"Labels, not
locations... The path becomes a binding the host answers."*

A BARE CHECKOUT HAS NO HOST, AND SAYS SO. Cloned on its own, this engine is code with no instance,
and every verb that needs one stops with a sentence instead of inventing a default. That is the
point: a default would be somebody's website appearing in a repository that is not theirs.

System python on purpose, stdlib only.
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def host():
    """The node mounting this engine, or None. A station is marked by `machine/config/nodes`."""
    up = os.path.dirname(ROOT)
    return up if os.path.exists(os.path.join(up, "machine", "config", "nodes")) else None


def instance_file(h=None):
    """`you.yml` at the NODE's root — the same place `.advocate-engine`'s answer lives as
    `advocate.yml`. The engine ships `you.example.yml`; the host fills one in."""
    h = h or host()
    return os.path.join(h, "you.yml") if h else None


def instance(h=None):
    """The host's answers, as a dict. Empty when there is no host or no answers."""
    path = instance_file(h)
    out = {}
    if not path or not os.path.exists(path):
        return out
    for raw in open(path):
        line = raw.split("#")[0].strip()
        if not line or ":" not in line:
            continue
        k, v = line.split(":", 1)
        out[k.strip()] = v.strip().strip('"\'')
    return out


def path_for(label, h=None):
    """Where the host keeps a wanted label. `bottles` is written, so it lives under state/."""
    h = h or host()
    if not h:
        return None
    # `bottles` is DERIVED -- regenerated by bin/publish, never authored -- so it lives under the
    # node's `state/`, which is where this node keeps what it writes rather than what it holds.
    # Everything else is the node's answer and lives in its `you.yml`.
    if label == "bottles":
        return os.path.join(h, "state", "you", "bottles")
    return instance_file(h)


def require():
    """The host, or a stop. Every verb that needs an instance calls this."""
    h = host()
    if not h:
        sys.exit("this engine holds no instance: it is code, wielded by the node that mounts it.\n"
                 "There is no station above this checkout (no ../machine/config/nodes), so there is\n"
                 "nothing to publish and nothing to deploy. That is correct for a bare clone.")
    return h


def main():
    a = sys.argv[1:]
    h = host()
    if a and a[0] == "path":
        p = path_for(a[1]) if len(a) > 1 else None
        if p:
            print(p)
        return 0 if p else 1
    if a and a[0] == "instance":
        for k, v in sorted(instance(h).items()):
            print("%s=%s" % (k, v))
        return 0
    if not h:
        print("  no host. These bytes are a bare checkout of the engine, which holds no instance.")
        print("  Mount it at <node>/.you-engine and the node answers what this is.")
        return 1
    inst = instance(h)
    print("  host        %s" % h)
    print("  instance    %s" % (instance_file(h) if inst else "declared and unanswered — no you.yml at the node root"))
    for k, v in sorted(inst.items()):
        print("    %-10s %s" % (k, v))
    for label in ("bottles",):
        p = path_for(label, h)
        print("  %-11s %s%s" % (label, p, "" if os.path.exists(p) else "   (absent)"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
