#!/bin/zsh
# control — the branch whose HEAD is the payload. One commit, no history, force-pushed.
#
#     bin/control init     (re)make refs/heads/control: an orphan commit of CONTROL.md + channels.json
#     bin/control show     what it holds now
#
# Built with plumbing so the working tree is never touched: the payload is a tree written straight
# into the object store and a parentless commit pointing at it. Re-running init replaces the branch
# outright, which is the design (README: "Revocation is an empty branch") -- there is nothing on it
# worth keeping between publishes, because what was published is what the recipients hold.
emulate -L zsh; set -euo pipefail; cd "${0:A:h:h}"
ref=refs/heads/control
case "${1:-}" in
  init)
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    md=$(cat <<MD
# control

The payload branch of the control point at $(sed -nE 's/^url:[[:space:]]*"?([^"]+)"?/\1/p' you.yml | head -1).

One commit, no parents, remade on every publish (\`bin/control init\`, \`bin/publish\`). What you are
holding is the whole branch: there is nothing behind it to fast-forward from, and the next one you
receive replaces it. An empty branch is a revoked one.

written $now
MD
)
    b1=$(print -r -- "$md" | git hash-object -w --stdin)
    b2=$(git hash-object -w channels.json)
    tree=$(printf '100644 blob %s\tCONTROL.md\n100644 blob %s\tchannels.json\n' "$b1" "$b2" | git mktree)
    commit=$(git commit-tree "$tree" -m "control: $now")
    git update-ref "$ref" "$commit"
    print "  $ref -> ${commit[1,7]}  (orphan, 2 files)"
    ;;
  show|"")
    git rev-parse -q --verify "$ref" >/dev/null || { print "  no control branch. bin/control init"; exit 1; }
    git log -1 --format='  %h  %s' "$ref"; git ls-tree -l "$ref" | awk '{printf "    %-14s %s bytes\n", $5, $4}'
    ;;
  *) print -u2 "usage: bin/control [init|show]"; exit 2;;
esac
